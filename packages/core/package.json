{
  "name": "@kotori/core",
  "version": "0.1.17",
  "description": "Kotori platform-neutral core: shared types, Gemini Flash explain engine, subtitle/manga/acquisition parsers. Runs unchanged in Node 22+ and browsers (no Node-only imports).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./ai": "./src/ai/index.ts",
    "./subtitle": "./src/subtitle/index.ts",
    "./manga": "./src/manga/index.ts",
    "./acquire": "./src/acquire/index.ts",
    "./util": "./src/util/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
