{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "build.mjs", "bin/*.mjs", "vitest.setup.ts"],
  "exclude": ["dist", "node_modules"]
}
