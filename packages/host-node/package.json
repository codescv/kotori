{
  "name": "@kotori/host-node",
  "version": "0.1.28",
  "description": "Kotori desktop host (macOS / Linux): pure Node.js server (node:sqlite, HTTP Range video streaming, pure-TS BitTorrent engine, ffmpeg subtitle extraction) + browser REST client implementing PlatformHost.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kotori": "./bin/kotori.mjs"
  },
  "exports": {
    ".": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./shared": "./src/shared/index.ts"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server/main.ts --dev",
    "dev:web": "vite dev web",
    "build:server": "node build.mjs",
    "build:web": "vite build web",
    "build": "pnpm run build:web && pnpm run build:server",
    "start": "node bin/kotori.mjs",
    "start:app": "node bin/kotori.mjs --new-browser"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@kotori/core": "workspace:*",
    "bencode": "^4.0.0",
    "bittorrent-dht": "^11.0.10",
    "bittorrent-protocol": "^5.0.8",
    "fflate": "^0.8.3",
    "google-auth-library": "^10.1.0",
    "hono": "^4.8.3",
    "ut_metadata": "^4.0.3"
  },
  "devDependencies": {
    "@kotori/ui": "workspace:*",
    "@types/node": "~22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.6",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
