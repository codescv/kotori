{
  "name": "kotori-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Kotori（ことり）— customizable Japanese immersion learning tool (anime + manga + Gemini Flash breakdown).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "check:native": "node scripts/check-native-deps.mjs",
    "dev:ui": "pnpm --filter @kotori/ui dev",
    "dev:node": "pnpm --filter @kotori/host-node dev",
    "start:node": "pnpm --filter @kotori/host-node start"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
