{
  "name": "kotori-monorepo",
  "private": true,
  "version": "0.1.4",
  "description": "Kotori（小鳥 / 言採り）— 表面是可爱的「小鸟」，拆开则是「言（こと）+ 採り（とり）」：采撷词句之人（Sentence Miner 的绝佳和风雅称）。",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "check:native": "node scripts/check-native-deps.mjs",
    "dev": "pnpm --filter @kotori/host-node dev",
    "start": "pnpm --filter @kotori/host-node start",
    "start:app": "pnpm --filter @kotori/host-node start:app",
    "start:new": "pnpm --filter @kotori/host-node start:app",
    "bump:version": "node scripts/bump-version.mjs",
    "build:apk": "pnpm --filter @kotori/host-android build:apk",
    "dev:ui": "pnpm --filter @kotori/ui dev",
    "dev:node": "pnpm --filter @kotori/host-node dev",
    "start:node": "pnpm --filter @kotori/host-node start"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
